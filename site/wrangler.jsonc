{
  // omapocket.org: static files only. The applet store is applets.pocket.nexus,
  // pocket-nexus/applets' Worker, which also answers oma.pocket.nexus (its API,
  // and a redirect here for every page).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "omapocket",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [
    { "pattern": "omapocket.org", "custom_domain": true },
    { "pattern": "www.omapocket.org", "custom_domain": true }
  ]
}
