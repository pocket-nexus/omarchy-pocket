// The uConsole's user (the omarchy-pocket group, which the package's postinst
// puts them in) switches the panel between Omarchy Pocket and the Raspberry Pi
// desktop without a password, from either (omarchy-pocket-session on|off).
// omarchy-pocketd runs Omarchy's scripts from a system service, outside the
// shell's logind session, so polkit would see an inactive caller: the user
// may also suspend, reboot and power off, and change networks and Bluetooth,
// as from the session itself.
polkit.addRule(function (action, subject) {
  if (!subject.isInGroup("omarchy-pocket")) return polkit.Result.NOT_HANDLED;
  var id = action.id;
  if (id == "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit") || "";
    if (/^(omarchy-pocket|omarchy-pocketd|lightdm|bluetooth|tailscaled)\.service$/.test(unit)) return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
  }
  if (id.indexOf("org.freedesktop.login1.") == 0 || id.indexOf("org.freedesktop.NetworkManager.") == 0 || id.indexOf("org.bluez.") == 0) return polkit.Result.YES;
  return polkit.Result.NOT_HANDLED;
});
