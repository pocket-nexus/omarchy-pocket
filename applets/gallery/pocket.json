{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.omarchy-pocket.gallery",
  "name": "omarchy-pocket-gallery",
  "title": "PocketJS: Gallery (L / R paging)",
  "version": "0.6.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "vendor/pocketjs/apps/gallery/main.tsx",
    "output": "gallery-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          512,
          384
        ],
        "presentation": "native"
      }
    }
  }
}
