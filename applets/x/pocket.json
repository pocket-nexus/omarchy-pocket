{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.x",
  "name": "pocket-x",
  "title": "X",
  "version": "0.1.0",
  "applet": {
    "version": 1,
    "services": [
      "x",
      "glyphs"
    ]
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary",
        "net.http"
      ],
      "enhances": [
        "input.analog.left",
        "system.agent"
      ]
    }
  },
  "app": {
    "entry": "applets/x/main.tsx",
    "output": "x-main",
    "framework": "solid",
    "modality": {
      "touch": "auxiliary"
    },
    "surfaces": {
      "auxiliary": {
        "adaptive": {
          "min": [
            320,
            240
          ],
          "max": [
            640,
            720
          ]
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [
          512,
          384
        ],
        "presentation": "native"
      }
    }
  }
}
