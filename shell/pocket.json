{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.omarchy-pocket",
  "name": "omarchy-pocket",
  "title": "Omarchy Pocket",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary"
      ]
    }
  },
  "app": {
    "entry": "shell/src/main.tsx",
    "output": "omarchy-pocket-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "fixed": { "logical": [512, 384], "presentation": "native" }
      }
    },
    "viewport": {
      "fixed": { "logical": [512, 384], "presentation": "native" }
    }
  }
}
